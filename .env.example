# Copie ce fichier en .env (en local) et/ou ajoute la variable dans
# Netlify > Project configuration > Environment variables.
#
# Récupère ton ID de mesure sur https://analytics.google.com
# (Admin > Flux de données > ton site web > ID de mesure, ex: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
